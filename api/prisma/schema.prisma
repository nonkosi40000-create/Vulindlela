datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  JOBSEEKER
  EMPLOYER
  MENTOR
  ADMIN
}

enum ShieldStatus {
  GREEN
  YELLOW
  NONE
}

enum OpportunityType {
  LEARNERSHIP
  MICRO_INTERNSHIP
  INFORMAL
  FULL_TIME
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

model User {
  id                    String         @id @default(uuid())
  mobile                String         @unique
  email                 String?        @unique
  passwordHash          String?
  role                  Role           @default(JOBSEEKER)
  language              String         @default("en")
  accessibilityPrefs    Json?
  isProfileComplete     Boolean        @default(false)
  guardianVerified      Boolean        @default(false)
  refreshTokenVersion   Int            @default(0)
  lastLogin             DateTime?
  createdAt             DateTime       @default(now())

  profile               Profile?
  consents              ConsentLog[]
  applications          Application[]
  reportedListings      ShieldReport[] @relation("Reporter")
  assessments           SkillAssessment[]
  receivedVouches       Vouch[]        @relation("VouchRecipient")
  givenVouches          Vouch[]        @relation("VouchGiver")
}

model ConsentLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  version         String
  language        String
  purposes        Json
  ipHash          String
  timestamp       DateTime @default(now())
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  fullName        String
  area            String
  skills          String[]
  bio             String?
  informalExp     Json?
  availability    String?
  transportBudget Float?
}

model Opportunity {
  id              String          @id @default(uuid())
  title           String
  description     String
  type            OpportunityType
  employerId      String
  location        String
  latitude        Float?
  longitude       Float?
  stipend         Float?
  estimatedTaxi   Float?
  shield          ShieldStatus    @default(NONE)
  requirements    String[]
  isSuspended     Boolean         @default(false)

  applications    Application[]
  reports         ShieldReport[]
  tasks           AssessmentTask[]
}

model Application {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  status        String      @default("PENDING")
  appliedAt     DateTime    @default(now())
}

model ShieldReport {
  id          String      @id @default(uuid())
  listingId   String
  listing     Opportunity @relation(fields: [listingId], references: [id])
  reporterId  String
  reporter    User        @relation("Reporter", fields: [reporterId], references: [id])
  reason      String
  details     String?
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now())
}

model SkillAssessment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  skillName       String
  status          AssessmentStatus @default(NOT_STARTED)
  score           Int?
  feedback        String?
  evidenceUrl     String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
}

model AssessmentTask {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  title           String
  description     String
  instructions    String
  deliverableType String
}

model Vouch {
  id              String   @id @default(uuid())
  recipientId     String
  recipient       User     @relation("VouchRecipient", fields: [recipientId], references: [id])
  giverId         String
  giver           User     @relation("VouchGiver", fields: [giverId], references: [id])
  relationship    String
  skill           String
  comment         String
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
}
