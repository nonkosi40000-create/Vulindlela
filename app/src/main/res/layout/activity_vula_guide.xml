<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_black">

    <!-- Header -->
    <View
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/slate_800"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_vula_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:src="@drawable/ic_logo_vulindlela"
        app:layout_constraintBottom_toBottomOf="@id/chat_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/chat_header" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Vula Guide"
        android:textColor="@color/brand_white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/chat_header"
        app:layout_constraintStart_toEndOf="@id/img_vula_avatar"
        app:layout_constraintTop_toTopOf="@id/chat_header" />

    <!-- Chat Bubbles Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/input_area"
        app:layout_constraintTop_toBottomOf="@id/chat_header" />

    <!-- Bottom Input -->
    <LinearLayout
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/slate_800"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:hint="Type your message..."
            android:paddingStart="20dp"
            android:textColor="@color/brand_white"
            android:textColorHint="@color/white_transparent" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="@color/brand_green"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/brand_white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>