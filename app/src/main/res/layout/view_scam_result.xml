<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/slate_800"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/soft_coral"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_scam_alert"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_sys_warning"
                app:tint="@color/soft_coral" />

            <TextView
                android:id="@+id/tv_scam_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="HIGH RISK SCAM"
                android:textColor="@color/soft_coral"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_listen_scam"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Listen to risk"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/brand_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_scam_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Real employers never ask you to pay to get a job. This message mentions 'Registration Fees'."
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_red_flags_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RED FLAGS FOUND:"
            android:textColor="@color/sunrise_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_red_flags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Pay R250 upfront\n• Personal WhatsApp number\n• Immediate start without interview"
            android:textColor="@color/white"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btn_scam_report"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/soft_coral"
            android:text="REPORT THIS LISTING"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btn_scam_dismiss"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="I UNDERSTAND, GO BACK"
            android:textColor="@color/white" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>